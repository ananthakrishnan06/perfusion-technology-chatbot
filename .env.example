# ==============================================================================
# PerfusionGPT Environment Variables
# ==============================================================================

# LLM Provider Configuration ("gemini" as primary, "groq" as fallback)
PRIMARY_LLM_PROVIDER=gemini

# Google Gemini API Configuration (Primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=4096
GEMINI_REQUEST_TIMEOUT=60.0

# Groq API Configuration (Automatic Fallback Provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096
GROQ_REQUEST_TIMEOUT=60.0

# Embedding Configuration (Local execution)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Ingestion & Chunking
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval & Ranking
TOP_K_SEMANTIC=10
TOP_K_BM25=10
TOP_K_FINAL=5
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# CORS Configuration
CORS_ORIGINS=["*"]

# App Settings
DEBUG=false

# Google OAuth 2.0 Sign-In
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_BRANCH=production

# Supabase Authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
