{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://perfusion-backend.azurewebsites.net/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://perfusion-backend.azurewebsites.net/health"
    },
    {
      "source": "/docs",
      "destination": "https://perfusion-backend.azurewebsites.net/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://perfusion-backend.azurewebsites.net/openapi.json"
    },
    {
      "source": "/app/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}

